 <Manufacturer>GLP</Manufacturer>
 <Model>Impression X5 Bar 1000</Model>
 <Type>LED Bar (Pixels)</Type>
 <Channel Name="Tilt" Preset="PositionTilt"/>
 <Channel Name="Tilt Fine" Preset="PositionTiltFine"/>
 <Channel Name="Master Dimmer " Preset="IntensityMasterDimmer"/>
 <Channel Name="Master Dimmer Fine" Preset="IntensityMasterDimmerFine"/>
 <Channel Name="Shutter">
  <Group Byte="1">Intensity</Group>
  <Capability Min="0" Max="4">Closed</Capability>
  <Capability Min="5" Max="9">Single flash each time value is changed within range 005 → 009</Capability>
  <Capability Min="10" Max="39">Pulse slow → fast</Capability>
  <Capability Min="40" Max="69">Pulse opening slow → fast</Capability>
  <Capability Min="70" Max="99">Pulse closing slow → fast</Capability>
  <Capability Min="100" Max="129">Double flash slow → fast</Capability>
  <Capability Min="130" Max="159">Strobe random pixel slow → fast</Capability>
  <Capability Min="160" Max="199">Strobe random all slow → fast</Capability>
  <Capability Min="200" Max="250">Strobe sync all pixels slow → fast</Capability>
  <Capability Min="251" Max="255">Open</Capability>
 </Channel>
 <Channel Name="Zoom" Preset="BeamZoomSmallBig"/>
 <Channel Name="Contol/Settings">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="255">not in use</Capability>
 </Channel>
 <Channel Name="CTC (Color&#10;Temperature&#10;Control)">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="9">Open</Capability>
  <Capability Min="10" Max="255">Fade through color temperatures of 10 000 K to 2 500 K stepless (interpolation)</Capability>
 </Channel>
 <Channel Name="CQC (Color Quality Control) / Saturation">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="9">HQ (high quality), saturated color</Capability>
  <Capability Min="10" Max="117">Crossfade, saturated to unsaturated color</Capability>
  <Capability Min="118" Max="127">HQ (high quality), unsaturated color</Capability>
  <Capability Min="128" Max="137">HO (high output), unsaturated color</Capability>
  <Capability Min="138" Max="245">Crossfade, unsaturated to saturated color</Capability>
  <Capability Min="246" Max="255">HO (high output), saturated color</Capability>
 </Channel>
