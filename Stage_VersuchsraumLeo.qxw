  <Function ID="1" Type="Sequence" Name="Playback Sequence --- ISI - Scene Transitions" BoundScene="0">
   <Speed FadeIn="0" FadeOut="0" Duration="185"/>
   <Direction>Forward</Direction>
   <RunOrder>SingleShot</RunOrder>
   <SpeedModes FadeIn="PerStep" FadeOut="PerStep" Duration="PerStep"/>
   <Step Number="0" FadeIn="300" Hold="4294967294" FadeOut="0" Note="Fade to black from ISI" Values="2">4:0,255</Step>
   <Step Number="1" FadeIn="0" Hold="4294967294" FadeOut="0" Note="Scene Activated" Values="2"/>
   <Step Number="2" FadeIn="100" Hold="4294967294" FadeOut="0" Note="Fade to black from Scene" Values="2">4:0,255</Step>
   <Step Number="3" FadeIn="0" Hold="4294967294" FadeOut="0" Note="ISI activated" Values="2">4:0,255,1,255</Step>
  </Function>
