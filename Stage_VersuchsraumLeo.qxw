   <Step Number="0" FadeIn="0" Hold="0" FadeOut="0" Note="Bright RoomLight" Values="2">6:0,255</Step>
   <Step Number="1" FadeIn="0" Hold="0" FadeOut="0" Note="Dim/Weak Roomlight" Values="2">7:0,255</Step>
   <Step Number="2" FadeIn="0" Hold="0" FadeOut="0" Note="No Roomlight" Values="2"/>
  </Function>
